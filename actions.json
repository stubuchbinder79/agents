{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/actions.schema.json",
  "version": "1.0",
  "actions": [
    {
      "id": "FollowUpNonResponders",
      "name": "Follow Up Non-Responders",
      "description": "Find a single upcoming meeting organized by the current user, summarize attendee responses, and optionally create or reuse a private Teams channel and remind only attendees whose latest response is none.",
      "operationId": "FollowUpNonResponders",
      "inputs": {
        "meetingSubject": {
          "type": "string",
          "description": "Required. A distinctive part of the meeting subject."
        },
        "daysAhead": {
          "type": "integer",
          "description": "Number of days ahead to search, from 1 through 365.",
          "default": 7
        },
        "createChannel": {
          "type": "boolean",
          "description": "Set true only when the user explicitly requests follow-up communication.",
          "default": false
        }
      },
      "outputs": {
        "status": {
          "type": "string",
          "description": "completed, noMeetingFound, multipleMeetingsFound, noNonResponders, followUpDisabled, partial, or failed."
        },
        "message": {
          "type": "string"
        },
        "meetingSubject": {
          "type": "string"
        },
        "meetingStart": {
          "type": "string"
        },
        "accepted": {
          "type": "integer"
        },
        "tentative": {
          "type": "integer"
        },
        "declined": {
          "type": "integer"
        },
        "noResponse": {
          "type": "integer"
        },
        "channelName": {
          "type": "string"
        },
        "usersAdded": {
          "type": "integer"
        },
        "remindersSent": {
          "type": "integer"
        },
        "nonResponders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          }
        },
        "followUpFailures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "errorCode": {
          "type": "string"
        }
      }
    }
  ]
}
